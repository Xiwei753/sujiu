{
  app: {
    // Signing stays unset in the repo on purpose.
    //
    // A signing config whose material is present but empty makes the HAP
    // signing task fail with "Invalid storeFile value" instead of falling back
    // to an unsigned HAP, so an empty placeholder is not a working default.
    //
    // `devecocli signature generate --product default` adds the signingConfigs
    // entry and the product's reference to it, with the real storeFile,
    // certpath and profile paths, key alias and encrypted passwords. Those are
    // machine local and secret: never commit them. Run it once per machine,
    // then `devecocli build --modules entry --build-mode debug` produces a
    // signed HAP. See apps/harmony/README.md.
    signingConfigs: [],
    products: [
      {
        name: 'default',
        bundleName: 'com.xiwei.sujiu',
        compileSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        targetSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        arkTSVersion: '1.1',
        bundleType: 'app',
        label: '$string:app_name',
        icon: '$media:app_icon',
        versionCode: 1000000,
        versionName: '0.1.0',
        vendor: 'xiwei',
        resource: {
          directories: [
            './AppScope/resources',
          ],
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}