# HarmonyOS build outputs and local toolchain state
apps/harmony/**/build/
# ohpm installs into every module that declares dependencies, not only the
# project root: wiring the generated N-API declaration as a local folder
# package makes entry/oh_modules appear. Matching the whole tree is the same
# rule as the build/ line above, not a second rule for a second directory.
apps/harmony/**/oh_modules/
apps/harmony/**/oh-package-lock.json5
apps/harmony/local.properties

# Local, uncommitted test credentials.
#
# This holds real API keys used to exercise endpoint probing by hand. It must
# never be committed: a key in the repository is a leaked key, and one in a
# build output is a leaked key that ships. Test keys are free and disposable,
# but "free" is not the same as "public".
/local/

# Rust
/target/
